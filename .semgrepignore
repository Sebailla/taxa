# .semgrepignore — opengrep ignore patterns (gitignore-like syntax, ALWAYS respected).
#
# These files trigger false positives on opengrep's generic python-sql-injection
# rule (parameterless queries like PRAGMA, DDL ALTER TABLE, BEGIN/COMMIT transaction
# markers) and python-mutable-class-attr (module-level dicts the rule mis-classifies
# as class-level attrs). The actual code is safe — no user input reaches these queries.

# ETL loaders with parameterless PRAGMA/DDL/BEGIN/COMMIT queries
etl/load_coldp.py
etl/load_distribution.py
etl/cleanup_biota_variants.py

# Migration runner with f-string PRAGMA that uses a validated int (already has nosemgrep
# but opengrep still flags it). The int is validated by isinstance() before reaching the query.
etl/migrations.py

# API server has a module-level dict (_CONTENT_TYPE_BY_EXT) that opengrep's
# python-mutable-class-attr rule misidentifies as a class attribute.
# It's module-level and intentionally read-only at runtime.
api/server.py
