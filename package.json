{
  "name": "taxa-frontend-build",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for the taxa frontend (G5/G6 + Next.js migration)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i web/index.css -o web/dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i web/index.css -o web/dist/tailwind.css --watch",
    "build:web": "next build",
    "dev": "next dev",
    "dev:local": "NEXT_PUBLIC_TAXA_API_ORIGIN=http://127.0.0.1:8765 next dev",
    "check-runtime": "node scripts/check-runtime.mjs",
    "g4:candidate-manifest": "node scripts/generate_g4_candidate_manifest.mjs --candidate-html out/index.html --candidate-url http://127.0.0.1:8765/index.html --candidate-manifest out/candidate.manifest.json"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": ">=5.1.0"
  }
}
