{
  "name": "taxa-frontend-build",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for the taxa frontend",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i web/index.css -o web/dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i web/index.css -o web/dist/tailwind.css --watch",
    "build:web": "next build",
    "check-runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": ">=5.1.0"
  }
}
