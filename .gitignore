# Local Pi runtime state
.atl/
.pi/

# API key — DO NOT COMMIT
.mcp.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data — large local snapshots (DB rebuilt via `make etl && make coldp`)
data/
data/raw/
data/db/*.db
data/db/*.db-shm
data/db/*.db-wal
data/*.log

# Editors
.vscode/
.idea/
.DS_Store

# User-generated research folder structure — created on demand by clicking
# the materialize icon in the web UI (POST /api/taxon/{id}/materialize).
# The folder contents (notes, references) are managed by the user and
# should not be committed.
Research/
# OpenSpec spec deltas live under `openspec/changes/<name>/specs/research/`
# (lowercase). The `Research/` ignore rule above matches case-insensitively
# on macOS and would silently drop these. Explicit negation keeps the spec
# deltas tracked while still ignoring user-generated Research content.
!openspec/changes/*/specs/research/
!openspec/changes/archive/*/specs/research/
!openspec/specs/research/
# PR 2a introduces a tracked capability module at `src/modules/research/`
# (lowercase). Same case-insensitive collision on macOS would silently drop
# the scaffold (`index.ts` barrel + 4 layer `.gitkeep` placeholders).
# Explicit negation keeps the capability tracked while still ignoring the
# user-generated `Research/` content above.
!src/modules/research/

# Node + Tailwind build — install with `npm install`, rebuild with
# `npm run build:css` (or `make css`). The compiled CSS in web/dist/ is
# deterministic from the source + tailwind.config.js, so it's not
# committed; CI and fresh clones regenerate it on demand.
node_modules/
web/dist/

# Impeccable design critiques + annotations — local-only notes produced by
# the .impeccable/ CLI skill during UI review. Not part of the source tree.
.impeccable/

# G4 capture (slice 1) — isolated pinned Node/Lighthouse workspace. The
# compiled `node_modules/` and atomic `out/` directories are local-only;
# raw Lighthouse reports / logs under `parity-reports/` are unversioned by
# contract. The versioned fixtures live under `tests/fixtures/g4/` and are
# tracked normally.
tools/g4-capture/node_modules/
tools/g4-capture/out/
parity-reports/
